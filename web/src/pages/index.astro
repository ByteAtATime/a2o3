---
import "../styles/global.css";
import { listWorks } from "../server/clickhouse";
import { cleanSummary } from "../lib/tags";
import WorkBlurb from "../components/WorkBlurb.astro";

const works = await listWorks();
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width" />
        <title>Works</title>
    </head>
    <body>
        <main class="mx-auto max-w-3xl px-2 py-4">
            <ul>
                {works.map((work, i) => (
                    <>
                        <WorkBlurb work={work} summary={cleanSummary(work.summary ?? "")} />

                        {i < works.length - 1 && <li class="border-b border-slate-300" aria-hidden="true"></li>}
                    </>
                ))}
            </ul>
        </main>
    </body>
</html>
