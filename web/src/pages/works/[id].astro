---
import "../../styles/global.css";
import DOMPurify from "isomorphic-dompurify";
import { marked } from "marked";
import RequiredTags from "../../components/RequiredTags.astro";
import { cleanSummary, parseTag } from "../../lib/tags";
import { findWork } from "../../server/clickhouse";
import { readWorkText } from "../../server/shardReader";
import { turnstileSiteKey } from "../../server/turnstile";

const workId = Number(Astro.params.id);
const work =
  Number.isInteger(workId) && workId > 0 ? await findWork(workId) : undefined;

if (!work) return new Response(null, { status: 404 });

const text = await readWorkText(workId);
const proseHtml =
  text === undefined ? undefined : DOMPurify.sanitize(await marked.parse(text));

const summary = work.summary ? cleanSummary(work.summary) : "";

const number = new Intl.NumberFormat("en-US");
const dateFormat = new Intl.DateTimeFormat("en-GB", {
  day: "2-digit",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
});
const formatDate = (isoDate: string) =>
  dateFormat.format(new Date(`${isoDate}T00:00:00Z`));

const tagSections = [
  { label: "Fandoms", values: work.fandoms, linked: true },
  { label: "Warnings", values: work.warnings, linked: true },
  { label: "Relationships", values: work.relationships, linked: true },
  { label: "Characters", values: work.characters, linked: true },
  { label: "Additional Tags", values: work.freeform_tags, linked: true },
  { label: "Collections", values: work.collections, linked: false },
].filter((section) => section.values.length > 0);

const details = [
  { label: "Language", value: work.language },
  { label: "Published", value: formatDate(work.published_date) },
  {
    label: "Updated",
    value: formatDate(work.updated_date ?? work.published_date),
  },
  ...[
    { label: "Words", value: work.words },
    { label: "Chapters", value: work.chapters_count },
    { label: "Kudos", value: work.kudos },
    { label: "Comments", value: work.comments },
  ].flatMap(({ label, value }) =>
    value === null ? [] : [{ label, value: number.format(value) }],
  ),
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>{work.title}</title>
  </head>
  <body>
    <main class="mx-auto max-w-3xl px-4 py-8 sm:py-12">
      <article class="space-y-8">
        <header class="flex items-center gap-4">
          <RequiredTags
            rating={work.rating}
            warnings={work.warnings}
            category={work.category}
            isCompleted={work.is_completed}
          />
          <div class="min-w-0 space-y-1">
            <h1 class="text-3xl font-semibold tracking-tight text-balance">
              {work.title}
            </h1>
            <p class="text-lg text-muted-foreground">
              {work.authors.join(", ")}
            </p>
          </div>
        </header>

        <section class="space-y-4 rounded-lg border bg-muted/40 p-4 text-sm">
          {tagSections.length > 0 && (
            <dl class="grid gap-x-4 gap-y-2 sm:grid-cols-[max-content_1fr]">
              {tagSections.map((section) => (
                <>
                  <dt class="font-medium text-muted-foreground">
                    {section.label}
                  </dt>
                  <dd>
                    {section.values.map((value, index) => {
                      const { label, href } = parseTag(value);
                      return (
                        <>
                          {index > 0 && (
                            <span class="text-muted-foreground">, </span>
                          )}
                          {section.linked ? (
                            <a class="hover:underline" href={href}>
                              {label}
                            </a>
                          ) : (
                            label
                          )}
                        </>
                      );
                    })}
                  </dd>
                </>
              ))}
            </dl>
          )}

          <dl
            class:list={[
              "flex flex-wrap gap-x-6 gap-y-1",
              tagSections.length > 0 && "border-t pt-4",
            ]}
          >
            {details.map((detail) => (
              <div class="flex gap-1.5">
                <dt class="text-muted-foreground">{detail.label}</dt>
                <dd class="font-medium tabular-nums">{detail.value}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="space-y-3 text-sm">
          <form
            method="post"
            action={`/works/${work.work_id}/remove`}
            class="space-y-3"
          >
            <div
              data-turnstile
              data-sitekey={turnstileSiteKey()}
              class="empty:hidden"
            ></div>
            <p class="text-muted-foreground">
              If this is your work and you don't want it here, you can{" "}
              <button
                type="submit"
                class="underline text-foreground cursor-pointer"
              >
                remove this work
              </button>
              .
            </p>
          </form>
        </section>

        {summary && (
          <blockquote class="border-l-4 border-[#900]/40 pl-4 whitespace-pre-line text-foreground/90">
            {summary}
          </blockquote>
        )}

        {proseHtml && (
          <div
            set:html={proseHtml}
            class="prose prose-lg max-w-none border-t pt-8 prose-neutral"
          />
        )}
      </article>
    </main>
    <script>
      type Turnstile = {
        render: (
          container: HTMLElement,
          options: { sitekey: string; callback: () => void },
        ) => string;
      };

      declare global {
        interface Window {
          turnstile?: Turnstile;
        }
      }

      const loadTurnstile = (): Promise<Turnstile> =>
        new Promise((resolve, reject) => {
          if (window.turnstile) return resolve(window.turnstile);
          const script = document.createElement("script");
          script.src =
            "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
          script.addEventListener("load", () =>
            window.turnstile ? resolve(window.turnstile) : reject(),
          );
          script.addEventListener("error", () => reject());
          document.head.append(script);
        });

      const container = document.querySelector<HTMLElement>("[data-turnstile]");
      const form = container?.closest("form");
      let started = false;

      if (container && form) {
        form.addEventListener("submit", async (event) => {
          event.preventDefault();
          if (started) return;
          started = true;
          try {
            const turnstile = await loadTurnstile();
            turnstile.render(container, {
              sitekey: container.dataset.sitekey ?? "",
              callback: () => form.submit(),
            });
          } catch {
            started = false;
          }
        });
      }
    </script>
  </body>
</html>
