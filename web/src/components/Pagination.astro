---
type Props = {
  page: number;
  pageCount: number;
  href: (page: number) => string;
};

const { page, pageCount, href } = Astro.props;

const number = new Intl.NumberFormat("en-US");
---

{pageCount > 1 && (
  <nav class="flex items-center gap-2 text-sm" aria-label="Pagination">
    {page > 1 && (
      <a
        class="rounded border border-slate-300 px-2 py-1 hover:bg-slate-100"
        href={href(page - 1)}
      >
        Previous
      </a>
    )}
    <span>
      Page {page} of {number.format(pageCount)}
    </span>
    {page < pageCount && (
      <a
        class="rounded border border-slate-300 px-2 py-1 hover:bg-slate-100"
        href={href(page + 1)}
      >
        Next
      </a>
    )}
  </nav>
)}
