---
import { parseTag } from "../lib/tags";
import type { WorkDetail } from "../server/clickhouse";
import RequiredTags from "./RequiredTags.astro";

type Tag = ReturnType<typeof parseTag>;
type TagKind = "warning" | "relationship" | "character" | "freeform";
type TagEntry = Tag & { kind: TagKind };

type Props = { work: WorkDetail; summary?: string | null };

const tagStyles: Record<TagKind, string> = {
    warning: "font-bold",
    relationship: "bg-[#eee]",
    character: "",
    freeform: "",
};

const tagged =
    (kind: TagKind) =>
    (tag: string): TagEntry => ({ ...parseTag(tag), kind });

const { work, summary = null } = Astro.props;

const number = new Intl.NumberFormat("en-US");
const month = new Intl.DateTimeFormat("en-GB", { day: "2-digit", month: "short", year: "numeric", timeZone: "UTC" });

const formatDate = (isoDate: string) => month.format(new Date(`${isoDate}T00:00:00Z`));
const published = formatDate(work.published_date);
const updated = formatDate(work.updated_date ?? work.published_date);
const chapters =
    work.chapters_total === null ? `${work.chapters_count}?` : `${work.chapters_count}/${work.chapters_total}`;

const tags: TagEntry[] = [
    ...work.warnings.map(tagged("warning")),
    ...work.relationships.map(tagged("relationship")),
    ...work.characters.map(tagged("character")),
    ...work.freeform_tags.map(tagged("freeform")),
];

const stats = [
    { label: "Language", value: work.language },
    { label: "Words", value: work.words === null ? "?" : number.format(work.words) },
    { label: "Chapters", value: chapters },
];
---

<li class="p-4 space-y-4">
    <div class="flex gap-3">
        <RequiredTags
            rating={work.rating}
            warnings={work.warnings}
            category={work.category}
            isCompleted={work.is_completed}
        />

        <div class="w-full">
            <div class="float-right">
                <p class="shrink-0 text-right text-slate-700" title={`Published ${published}`}>
                    {updated}
                </p>
            </div>

            <h4 class="min-w-0 text-slate-500">
                <a class="text-[#900] visited:text-[#900] underline text-base" href={`/works/${work.work_id}`}>
                    {work.title}
                </a>{" "}
                by{" "}
                {work.authors.map((author, index) => (
                    <>
                        {index > 0 && ", "}
                        <a class="text-slate-700 underline decoration-slate-400 hover:text-[#900]" href="/authors">
                            {author}
                        </a>
                    </>
                ))}
            </h4>

            <ul class="flex flex-wrap gap-x-2 gap-y-0.5">
                {work.fandoms.map((fandom) => {
                    const { label, href } = parseTag(fandom);
                    return (
                        <li>
                            <a class="text-slate-700 underline decoration-slate-400 hover:text-[#900]" href={href}>
                                {label}
                            </a>
                        </li>
                    );
                })}
            </ul>
        </div>
    </div>

    {tags.length > 0 && (
        <p>
            {tags.map(({ label, href, kind }, index) => (
                <>
                    {index > 0 && <span class="text-slate-500">, </span>}
                    <a class:list={["underline", tagStyles[kind]]} href={href}>
                        {label}
                    </a>
                </>
            ))}
        </p>
    )}

    {summary && <p class="whitespace-pre-line">{summary}</p>}

    <dl class="flex flex-wrap justify-end gap-x-6 text-slate-800">
        {stats.map((stat) => (
            <div class="flex gap-1">
                <dt>{stat.label}:</dt>
                <dd>{stat.value}</dd>
            </div>
        ))}
    </dl>
</li>
